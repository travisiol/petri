# ── PETRI server ─────────────────────────────────────────────────────────────
PORT=3719
DATA_DIR=./data

# Robinhood Chain (chain id 4663). Point RPC_URL at a local node for rehearsals.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER=https://robinhoodchain.blockscout.com

# Pons V2 (real mainnet addresses; chain/local.json overrides them on a local node)
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_FORWARDER=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
PONS_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e

# The vault: receives every token's creator fees on chain and pays the agents.
# Without it the site runs read-only (launches are closed, no keeper).
VAULT_PK=

# Encrypts agent wallet keys at rest (any long random string).
WALLET_SECRET=

# Operator key for /admin (consolidate).
ADMIN_KEY=

# The brain. Without ANTHROPIC_API_KEY (or an `ant auth login` profile) agents
# think with the built-in rule-based stub and post templated thoughts.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5
BRAIN=auto            # auto | stub

# Cadence (ms)
TICK_MS=120000        # one thought per agent
CLAIM_MS=60000        # vault claims + pays fees
INDEX_MS=15000        # chain indexer
STARVE_MS=172800000   # an agent with no fees and no compute for this long dies (48h)
