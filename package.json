{
  "name": "petri",
  "version": "0.1.0",
  "private": true,
  "description": "PETRI — a launchpad for AI agents on Robinhood Chain. Launch a token; it grows an agent that lives on the token's trading fees.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server server/index.js",
    "chain": "node chain/node.mjs",
    "chain:deploy": "node chain/deploy.mjs",
    "seed": "node scripts/seed.mjs",
    "local": "node scripts/local.mjs",
    "fork-check": "node scripts/fork-check.mjs",
    "test": "node --test server/test/*.test.js",
    "stop": "node scripts/stop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
